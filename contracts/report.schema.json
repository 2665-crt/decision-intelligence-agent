{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DecisionReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["domain", "evidence", "risks", "options", "suggestions"],
  "properties": {
    "domain": {"type": "string"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "artifact_id", "summary"],
        "properties": {
          "level": {"enum": ["A", "B", "C", "D"]},
          "artifact_id": {"type": ["string", "null"], "format": "uuid"},
          "summary": {"type": "string", "minLength": 1}
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description", "probability", "impact", "severity", "controllability",
          "evidence", "uncertainty", "mitigation", "human_review_required"
        ],
        "properties": {
          "description": {"type": "string", "minLength": 1},
          "probability": {"enum": ["low", "medium", "high"]},
          "impact": {"enum": ["low", "medium", "high"]},
          "severity": {"enum": ["low", "medium", "high", "critical"]},
          "controllability": {"enum": ["low", "medium", "high"]},
          "evidence": {"type": "array", "minItems": 1},
          "uncertainty": {"type": "string", "minLength": 1},
          "mitigation": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "human_review_required": {"type": "boolean"}
        }
      }
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name", "expected_benefit", "implementation_cost", "potential_harm",
          "uncertainty", "assumptions", "validation_metric", "hard_constraints_met"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "expected_benefit": {"type": "number", "minimum": 0, "maximum": 1},
          "implementation_cost": {"type": "number", "minimum": 0, "maximum": 1},
          "potential_harm": {"type": "number", "minimum": 0, "maximum": 1},
          "uncertainty": {"type": "number", "minimum": 0, "maximum": 1},
          "assumptions": {"type": "array", "items": {"type": "string"}},
          "validation_metric": {"type": "string", "minLength": 1},
          "hard_constraints_met": {"type": "boolean"}
        }
      }
    },
    "suggestions": {"type": "array", "items": {"type": "string"}}
  }
}
